---
import '@fontsource-variable/manrope';
import './style.css';
const {title,description,preview="portada"}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · Praxis Fisioformación</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(base+'media/'+preview+'.png',Astro.site)}/><link rel="icon" href={base+'media/praxis.png'}/></head><body><a class="skip" href="#principal">Saltar al contenido</a><header>
  <a class="brand" href={base}><img src={base+'media/firma.svg'} width="208" height="40" alt="Praxis Fisioformación, inicio"/></a>
  <nav class="wide-nav" aria-label="Principal"><a href={base+'#calendario'}>Calendario</a><a href={base+'#ecografia'}>Guía de ecografía</a><a href={base+'#equipo'}>Equipo docente</a></nav>
  <details class="mobile-menu">
    <summary>Menú <span aria-hidden="true">☰</span></summary>
    <nav aria-label="Principal móvil"><a href={base+'#calendario'}>Calendario</a><a href={base+'#ecografia'}>Guía de ecografía</a><a href={base+'#equipo'}>Equipo docente</a></nav>
  </details>
</header><main id="principal"><slot/></main><footer><a href={base}><img src={base+'media/firma-clara.svg'} width="184" alt="Praxis Fisioformación, inicio"/></a><a href={base+'#calendario'}>Calendario de formación</a></footer></body></html>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.addEventListener('click', event => {
    if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
