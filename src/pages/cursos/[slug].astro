---
import courses from '../../data/cursos.json';
import Site from '../../layouts/Site.astro';
import {marked} from 'marked';
export function getStaticPaths(){return courses.map(c=>({params:{slug:c.slug},props:{c}}))}
const {c}=Astro.props;
const sections = c.body.split(/(?=^### )/m);
const body = sections.map(section => {
  if (section.startsWith('### Programa')) {
    section = section.replace(/(?:^\d+\. \*\*[^*]+\*\* .+\n?)+/m, block => block.trimEnd().split('\n').map(line => {
      const [, title, description] = line.match(/^\d+\. \*\*([^*]+)\*\* (.+)$/) ?? [];
      return '<details class="program-module"><summary>' + marked.parseInline(title.replace(/\.$/, '')) +
        '</summary><div>' + marked.parse(description) + '</div></details>';
    }).join('\n') + '\n');
  }
  return marked.parse(section.replace(/^### /, '## ')).replace('<h2>Acceso y matrícula</h2>', '<h2 id="acceso">Acceso y matrícula</h2>');
}).join('');
const alertsEnabled = process.env.ENROLLMENT_ALERT_ENDPOINT?.startsWith('https://') &&
  process.env.ENROLLMENT_ALERT_PRIVACY_URL?.startsWith('https://');
const alertsHref = '../../#matricula';
const price = c.facts.find(fact => fact.includes('€'));
---
<Site preview={c.slug} title={c.title} description={c.desc}>
  <section class="course">
    <a class="back" href="../../#calendario">Volver al calendario 2027</a>
    <h1>{c.title}</h1><p class="lead">{c.desc}</p>
    <div class="coursegrid">
      <aside class="coursefacts">
        <strong class="factdate">{c.date}</strong>
        <p>{c.facts.join(' · ')}</p>
        <a class="button" href="#acceso">Ver acceso y plazos</a>
        {alertsEnabled && <a class="download" href={alertsHref}>Solicitar aviso de matrícula</a>}
        <a class="download" href={'../../calendario/'+c.slug+'.ics'} download>Guardar fechas en mi calendario</a>
        <details><summary>Credencial universitaria</summary><p>{c.credential}</p></details>
      </aside>
      <div class="program" set:html={body}/>
    </div>
    <aside class="mobile-course-action" aria-label="Datos de la convocatoria">
      <div><strong>{c.days} {c.month}</strong><small>{price}</small></div>
      <a class="button" href={alertsEnabled ? alertsHref : '#acceso'}>{alertsEnabled ? 'Solicitar aviso' : 'Ver acceso y plazos'}</a>
    </aside>
  </section>
</Site>
