---
import courses from '../../data/cursos.json';
import Site from '../../layouts/Site.astro';
import {marked} from 'marked';
export function getStaticPaths(){return courses.map(c=>({params:{slug:c.slug},props:{c}}))}
const {c}=Astro.props;
const body=marked.parse(c.body).replace('<h3>Acceso y matrícula','<h2 id="acceso">Acceso y matrícula').replaceAll('<h3>','<h2>').replaceAll('</h3>','</h2>');
---
<Site preview={c.slug} title={c.title} description={c.desc}>
  <section class="course">
    <a class="back" href="../../#calendario">← Calendario 2027</a>
    <h1>{c.title}</h1><p class="lead">{c.desc}</p>
    <div class="coursegrid">
      <aside class="coursefacts">
        <strong class="factdate">{c.date}</strong>
        <p>{c.facts.join(' · ')}</p>
        <a class="button" href="#acceso">Ver acceso y plazos <span aria-hidden="true">↓</span></a>
        <a class="download" href={'../../calendario/'+c.slug+'.ics'} download>Guardar fechas en mi calendario</a>
        <details><summary>Credencial universitaria</summary><p>{c.credential}</p></details>
      </aside>
      <div class="program" set:html={body}/>
    </div>
  </section>
</Site>
