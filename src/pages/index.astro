---
import Site from '../layouts/Site.astro';
import courses from '../data/cursos.json';
const url=(c)=>'cursos/'+c.slug+'/';
const next=courses.find(c=>c.end>=new Date().toISOString().slice(0,10));
const guide=[{c:courses[0],label:'Básico e intermedio',text:'Manejo del ecógrafo y exploración sistemática de las extremidades.'},{c:courses[3],label:'Nivel III',text:'Cartografía neural periférica y valoración dinámica de la pared abdominal y la ingle.'},{c:courses[4],label:'Neuroeje',text:'Exploración de la articulación temporomandibular, la columna y la región sacropélvica.'}];
---
<Site title="Formación universitaria para la práctica clínica" description="Formación de fisioterapia en Málaga. Consulta los programas, compara niveles de ecografía y revisa requisitos y fechas de la Universidad de Málaga.">
  <section class="hero">
    <div class="intro">
      <p class="location">Málaga <span> / </span> Curso 2027</p>
      <h1>Formación universitaria para la práctica clínica</h1>
      <p class="lead">Práctica supervisada para fisioterapeutas y profesionales sanitarios en cursos impartidos por la Universidad de Málaga.</p>
      <a class="button" href="#calendario">Ver calendario 2027</a>
    </div>
    {next && <a class="feature" href={url(next)}>
      <div class="scan" aria-hidden="true"><i></i><b></b></div>
      <small>Próxima formación</small>
      <div class="feature-info">
        <div class="stamp">{next.days} <span>{next.month} 2027</span></div>
        <div class="feature-name">{next.short}</div>
      </div>
    </a>}
  </section>
  <section id="calendario">
    <div class="section-head"><h2>Calendario 2027</h2><p>Facultad de Ciencias de la Salud · Málaga</p></div>
    <div class="agenda">{courses.map(c=><a href={url(c)}>
      <div class="date">{c.days}<small>{c.month}</small></div>
      <div class="entry"><h3>{c.short}</h3><span>{c.mode}</span></div>
      <span class="price">{c.price} <small>previstos</small></span>
    </a>)}</div>
  </section>
  <section id="ecografia"><h2>Qué curso de ecografía elegir</h2>
    <div class="guide">{guide.map(g=><article><h3>{g.label}</h3><p>{g.text}</p><a href={url(g.c)+'#acceso'} aria-label={'Consultar requisitos de '+g.label}>Consultar requisitos</a></article>)}</div>
  </section>
  <section id="equipo"><div><h2>Cómo se aprende en el aula</h2><p>La práctica guiada combina exploración, observación y discusión de casos. Cada programa detalla los ejercicios previstos y las competencias que se trabajan.</p></div>
    <div class="faculty"><h3>Equipo docente</h3><p><strong>Manuel González Sánchez</strong>Dirección y docencia</p><p><strong>Francisco José Extremera García</strong>Docencia</p><p>La Universidad de Málaga imparte los cursos y expide las credenciales correspondientes.</p></div>
  </section>
</Site>
